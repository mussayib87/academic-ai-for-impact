APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///./backend/data/academic_ai.db
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIRECTORY=./data/uploads
MAX_UPLOAD_SIZE=10485760
LLM_PROVIDER=ollama
LLM_MODEL_NAME=ollama:qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=300
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_PATH=./knowledge_base/vector_store
POSTGRES_DB=academic_ai
POSTGRES_USER=academic_ai
POSTGRES_PASSWORD=replace-this-with-a-unique-database-password